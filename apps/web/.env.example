# Postgres connection string (Supabase, Neon, local, whatever)
# Runtime uses the pooler (Supabase port 6543); migrations use DIRECT_URL.
DATABASE_URL="postgres://user:password@host:6543/dbname"

# Direct (non-pooled) connection for Drizzle migrations — Supabase port 5432.
DIRECT_URL="postgres://user:password@host:5432/dbname"

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-min-32-chars-xxxxxxxxxxxxxxxxxx"

# Public app URL (used by Better Auth + Eden client base URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AGENT_INGEST_KEY=shared-secret-for-agent-ingest
